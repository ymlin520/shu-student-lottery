{
  "_說明": "mode 可填 shu（世新 SSO）、mock（測試模式，任何帳密都會通過）、api（其他自訂 JSON API）。拿到世新系統組發的廠商帳號密碼後，把 id1、id2 填好，再把 mode 改成 shu，然後重新啟動程式。",
  "mode": "mock",

  "shu": {
    "_說明": "世新 SSO Web Service：ServSSO.asmx 的 SetUrlLog。env 填 test 走測試機、prod 走正式機。",
    "env": "test",
    "id1": "",
    "id2": "",
    "onlyCurrentStudent": true,
    "emailDomain": "@mail.shu.edu.tw",
    "keepRaw": false,
    "timeoutMs": 10000,

    "_測試機網址": "https://netoffice.shu.edu.tw/WebApp/S/00/ServSSO.asmx",
    "_正式機網址": "https://ap0.shu.edu.tw/WebApp/S/00/ServSSO.asmx",
    "_id1說明": "世新提供的廠商帳號（12 碼），不是學生帳號",
    "_id2說明": "世新提供的廠商密碼（12 碼）",
    "_onlyCurrentStudent說明": "true = 只有在校生可以報名（回傳欄位第 7 欄＝1）；false = 教職員、校友也可報名",
    "_測試帳號": "文件提供：A00000001/1000（在校生）、A00000002/2000（離校生）、A00000003/39988（教職員且在校生）"
  },

  "api": {
    "url": "",
    "method": "POST",
    "format": "json",
    "headers": {},
    "bodyTemplate": { "account": "{account}", "password": "{password}" },
    "successPath": "",
    "successValue": null,
    "errorPath": "message",
    "map": {
      "studentNo": "data.studentNo",
      "name": "data.name",
      "dept": "data.dept",
      "className": "data.className",
      "email": "data.email"
    },
    "keepRaw": false,
    "timeoutMs": 8000
  }
}
